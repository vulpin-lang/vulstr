# string.vul (old)
# String utilities for Vulpin

F upper
    s=K
    r=""
    i=0
    ? i<len(s)
        c=s[i]
        ? c>="a" & c<="z"
            r=r+chr(ord(c)-32)
        :
            r=r+c
        ;
        i=i+1
        ;
    R r
~

F lower
    s=K
    r=""
    i=0
    ? i<len(s)
        c=s[i]
        ? c>="A" & c<="Z"
            r=r+chr(ord(c)+32)
        :
            r=r+c
        ;
        i=i+1
        ;
    R r
~

F trim
    s=K
    i=0
    ? i<len(s) & s[i]=" "
        i=i+1
        ;
    j=len(s)-1
    ? j>=0 & s[j]=" "
        j=j-1
        ;
    ? i>j
        R ""
    ;
    R s[i:j+1]
~

F split
    s=K
    d=K
    r=[]
    c=""
    i=0
    ? i<len(s)
        ? s[i]=d
            r=r+[c]
            c=""
        :
            c=c+s[i]
        ;
        i=i+1
        ;
    r=r+[c]
    R r
~

F join
    a=K
    d=K
    r=""
    i=0
    ? i<len(a)
        ? i>0
            r=r+d
        ;
        r=r+a[i]
        i=i+1
        ;
    R r
~

F replace
    s=K
    o=K
    n=K
    r=""
    i=0
    ? i<len(s)
        ? s[i:i+len(o)]=o
            r=r+n
            i=i+len(o)
        :
            r=r+s[i]
            i=i+1
        ;
        ;
    R r
~

F repeat
    s=K
    n=K
    r=""
    i=0
    ? i<n
        r=r+s
        i=i+1
        ;
    R r
~

F starts_with
    s=K
    p=K
    ? len(p)>len(s)
        R 0
    ;
    R s[0:len(p)]=p
~

F ends_with
    s=K
    p=K
    ? len(p)>len(s)
        R 0
    ;
    R s[len(s)-len(p):]=p
~

F contains
    s=K
    p=K
    i=0
    ? i<=len(s)-len(p)
        ? s[i:i+len(p)]=p
            R 1
        ;
        i=i+1
        ;
    R 0
~

F reverse
    s=K
    r=""
    i=len(s)-1
    ? i>=0
        r=r+s[i]
        i=i-1
        ;
    R r
~

